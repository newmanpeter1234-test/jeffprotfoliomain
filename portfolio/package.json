{
  "name": "jefrine-correya-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test:content": "node scripts/check-content.mjs",
    "check": "npm run build && npm run test:content",
    "showreel:studio": "node scripts/showreel/studio.mjs",
    "native:timing": "python scripts/native-clean/approved-timing.py",
    "native:assets": "python scripts/native-clean/prepare-assets.py",
    "native:inspect": "node scripts/native-clean/inspect.mjs",
    "native:render": "node scripts/native-clean/render.mjs",
    "native:verify": "node scripts/native-clean/verify-source.mjs && python scripts/native-clean/verify-media.py"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
